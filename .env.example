# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI (Groq)
VITE_GROQ_API_KEY=gsk_your-groq-api-key

# BPOM Indonesia
VITE_BPOM_API_KEY=aip_live_your-bpom-api-key

# Email (Resend) - untuk Supabase Edge Functions
RESEND_API_KEY=re_your-resend-api-key

# Catatan: Jangan commit .env ke git! File ini sudah di .gitignore.
# Copy .env.example ke .env dan isi nilai yang sesuai.
